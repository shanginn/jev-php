{
    "name": "shanginn/jev-php",
    "description": "Type-safe PHP SDK for JEV decisions on OpenRouter: choices, scores, probabilities and typed objects.",
    "type": "library",
    "license": "MIT",
    "keywords": ["jev", "typesafe", "openrouter", "ai", "classification", "sdk"],
    "homepage": "https://github.com/shanginn/jev-php",
    "authors": [{"name": "Nikolai Shangin", "email": "shanginn@gmail.com"}],
    "require": {"php": "^8.5", "ext-json": "*", "amphp/http-client": "^5.3"},
    "require-dev": {"phpunit/phpunit": "^13.0", "phpstan/phpstan": "^2.1", "friendsofphp/php-cs-fixer": "^3.0"},
    "autoload": {"psr-4": {"Shanginn\\Jev\\": "src/"}},
    "autoload-dev": {"psr-4": {"Shanginn\\Jev\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "test:live": "php tests/live.php",
        "test:examples": "php tests/examples.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": ["@composer validate --strict", "@test", "@analyse", "@format:check"]
    },
    "config": {"sort-packages": true},
    "support": {"issues": "https://github.com/shanginn/jev-php/issues", "source": "https://github.com/shanginn/jev-php"}
}
